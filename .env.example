# ----------------------------------------------------------------------------
# JWT Secret — OBRIGATÓRIO em produção.
# Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo de 32 caracteres. A aplicação se recusa a subir em produção sem isso.
# ----------------------------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------------------------
# Senha inicial do usuário admin.
# - Se definida: a aplicação cria o admin com esta senha no primeiro boot.
# - Se vazia: uma senha aleatória forte é gerada e impressa nos logs UMA VEZ.
# Após o primeiro login, troque a senha pela interface.
# ----------------------------------------------------------------------------
INITIAL_ADMIN_PASSWORD=

# Node Environment
NODE_ENV=production

# Database Path (não mude isso no Coolify)
DATABASE_PATH=./data/dental-office.db

PORT=3000
HOSTNAME=0.0.0.0
